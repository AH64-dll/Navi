 "schemas": {
  "AbsolutePath": {
   "type": "string"
  },
  "Agent.ID": {
   "type": "string"
  },
  "Form.Answer": {
   "additionalProperties": {
    "$ref": "#/components/schemas/Form.Value"
   },
   "type": "object"
  },
  "Form.Reply": {
   "additionalProperties": false,
   "properties": {
    "answer": {
     "$ref": "#/components/schemas/Form.Answer"
    }
   },
   "required": [
    "answer"
   ],
   "type": "object"
  },
  "Form.Value": {
   "anyOf": [
    {
     "type": "string"
    },
    {
     "type": "number"
    },
    {
     "enum": [
      "Infinity",
      "-Infinity",
      "NaN"
     ],
     "type": "string"
    },
    {
     "type": "boolean"
    },
    {
     "items": {
      "type": "string"
     },
     "type": "array"
    }
   ]
  },
  "Location.PublicRef": {
   "additionalProperties": false,
   "properties": {
    "directory": {
     "$ref": "#/components/schemas/AbsolutePath"
    }
   },
   "required": [
    "directory"
   ],
   "type": "object"
  },
  "Model.Ref": {
   "additionalProperties": false,
   "properties": {
    "id": {
     "type": "string"
    },
    "providerID": {
     "$ref": "#/components/schemas/Provider.ID"
    },
    "variant": {
     "type": "string"
    }
   },
   "required": [
    "id",
    "providerID"
   ],
   "type": "object"
  },
  "Permission.Effect": {
   "enum": [
    "allow",
    "deny",
    "ask"
   ],
   "type": "string"
  },
  "Permission.Reply": {
   "enum": [
    "once",
    "always",
    "reject"
   ],
   "type": "string"
  },
  "Permission.Rule": {
   "additionalProperties": false,
   "properties": {
    "action": {
     "type": "string"
    },
    "effect": {
     "$ref": "#/components/schemas/Permission.Effect"
    },
    "resource": {
     "type": "string"
    }
   },
   "required": [
    "action",
    "resource",
    "effect"
   ],
   "type": "object"
  },
  "Permission.Ruleset": {
   "items": {
    "$ref": "#/components/schemas/Permission.Rule"
   },
   "type": "array"
  },
  "Prompt.AgentAttachment": {
   "additionalProperties": false,
   "properties": {
    "mention": {
     "$ref": "#/components/schemas/Prompt.Mention"
    },
    "name": {
     "type": "string"
    }
   },
   "required": [
    "name"
   ],
   "type": "object"
  },
  "Prompt.FileSource": {
   "anyOf": [
    {
     "additionalProperties": false,
     "properties": {
      "type": {
       "enum": [
        "inline"
       ],
       "type": "string"
      }
     },
     "required": [
      "type"
     ],
     "type": "object"
    },
    {
     "additionalProperties": false,
     "properties": {
      "type": {
       "enum": [
        "uri"
       ],
       "type": "string"
      },
      "uri": {
       "type": "string"
      }
     },
     "required": [
      "type",
      "uri"
     ],
     "type": "object"
    }
   ]
  },
  "Prompt.Mention": {
   "additionalProperties": false,
   "properties": {
    "end": {
     "type": "number"
    },
    "start": {
     "type": "number"
    },
    "text": {
     "type": "string"
    }
   },
   "required": [
    "start",
    "end",
    "text"
   ],
   "type": "object"
  },
  "PromptInput.FileAttachment": {
   "additionalProperties": false,
   "properties": {
    "description": {
     "type": "string"
    },
    "mention": {
     "$ref": "#/components/schemas/Prompt.Mention"
    },
    "name": {
     "type": "string"
    },
    "source": {
     "$ref": "#/components/schemas/Prompt.FileSource"
    },
    "uri": {
     "type": "string"
    }
   },
   "required": [
    "uri"
   ],
   "type": "object"
  },
  "PromptInput.SkillAttachment": {
   "additionalProperties": false,
   "properties": {
    "id": {
     "$ref": "#/components/schemas/Skill.ID"
    },
    "mention": {
     "$ref": "#/components/schemas/Prompt.Mention"
    }
   },
   "required": [
    "id"
   ],
   "type": "object"
  },
  "Provider.ID": {
   "type": "string"
  },
  "Session.ID": {
   "pattern": "^ses",
   "type": "string"
  },
  "Session.Inbox.Delivery": {
   "enum": [
    "steer",
    "queue"
   ],
   "type": "string"
  },
  "Session.Message.ID": {
   "pattern": "^msg_",
   "type": "string"
  },
  "Session.Metadata": {
   "type": "object"
  },
  "Skill.ID": {
   "type": "string"
  }
 }
}
